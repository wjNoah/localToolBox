{
  "manifest_version": 3,
  "name": "Local Dev Toolbox",
  "version": "0.1.0",
  "description": "Small developer utilities (JWT, Base64, timestamps, JSON, regex) that run 100% locally. No account, no network.",
  "homepage_url": "https://github.com/wjNoah/localToolBox",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Local Dev Toolbox",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": ["storage"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open Local Dev Toolbox"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'none'"
  }
}
